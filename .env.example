# outlive.diy environment.
#
# The application itself reads no environment variables at runtime: it is a
# static single-page app that makes no network calls. Everything here exists
# only for the build and the deploy.

# Canonical origin, used for metadata and the canonical link tag.
NEXT_PUBLIC_SITE_URL=https://outlive.diy

# Vercel CLI token, used by `make deploy`. Never committed.
VERCEL_TOKEN=
