# Secrets. The .env at the repository root is never committed; .env.example
# documents the shape of it instead.
.env
.env.local
.env.*.local

# Dependencies
node_modules/
.yarn/cache
.yarn/install-state.gz

# Build output
# next-env.d.ts is rewritten by every build, in a style prettier disagrees with,
# so committing it means the tree is dirty after any build and the format check
# fails on the next run. Next regenerates it on install and build.
apps/web/next-env.d.ts
.next/
.next-dev/
out/
dist/
*.tsbuildinfo
coverage/

# Hosting
.vercel

# Editors and OS
.idea/
*.iml
.DS_Store
.vscode/
